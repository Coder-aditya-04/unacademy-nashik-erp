{
  "name": "unacademy-nashik",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://prayaaseducation.co.in",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "test:rules": "firebase emulators:exec --only firestore --project demo-erp \"node tests/rules/firestore.rules.test.mjs firestore.rules\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project unacademy-nashik-erp",
    "seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 node scripts/seed-staging.mjs",
    "dev:local": "VITE_USE_EMULATOR=true vite",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project demo-erp \"node tests/rules/storage.rules.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.2.8",
    "@fontsource/anton": "5.3.0",
    "firebase": "^12.6.0",
    "gsap": "3.12.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.554.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "read-excel-file": "^9.3.20",
    "ua-parser-js": "^2.0.8"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.36.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.4"
  }
