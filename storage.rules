rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function staffProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isVerifiedStaff() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && staffProfile().get('verified', true) != false;
    }

    // Payment proofs: proofs/{admissionId}/{paymentId}.
    // Verified staff can view them and add new ones (image or PDF, 5 MB
    // max). A proof can never be overwritten or deleted from the app, so
    // the record of what was paid can't be quietly swapped.
    match /proofs/{admissionId}/{paymentId} {
      allow read: if isVerifiedStaff();
      allow create: if resource == null && isVerifiedStaff()
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
      allow update, delete: if false;
    }

    // Call recordings: call_recordings/{uid}/{callId}.{ext}. The telecaller's
    // app uploads the phone recorder's file once; only that telecaller and
    // a Manager or Director can listen. Never overwritten or deleted here.
    match /call_recordings/{uid}/{file} {
      allow read: if isVerifiedStaff()
                  && (request.auth.uid == uid || staffProfile().get('role', '').upper() in ['DIRECTOR', 'MANAGER']);
      allow create: if resource == null && isVerifiedStaff() && request.auth.uid == uid
                    && request.resource.size <= 25 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
      allow update, delete: if false;
    }

    // Everything else: staff-only reads. Images already shared by download
    // URL keep working, because those URLs carry their own access token.
    // (Rules that match the same path are OR'ed, so this one must skip
    // proofs/ and call_recordings/ or it would open them to every sign-in.)
    match /{top}/{rest=**} {
      allow read: if request.auth != null && top != 'proofs' && top != 'call_recordings';
      allow write: if false;
    }
    match /{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
