rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // 1. Is the user logged in?
    function isSignedIn() {
      return request.auth != null;
    }

    // 2. Fetch the User's Profile (Role & Center) from the 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 3. Is the user a DIRECTOR?
    function isDirector() {
      return isSignedIn() && getUserData().role.upper() == 'DIRECTOR';
    }

    // 4. Is the user an ACCOUNTANT?
    function isAccountant() {
      return isSignedIn() && getUserData().role.upper() == 'ACCOUNTANT';
    }

    // 4.5 Is the user a MANAGER?
    function isManager() {
        return isSignedIn() && getUserData().role.upper() == 'MANAGER';
    }

    // 5. Does the User belong to the same Center as the Data?
    // (Logic: Strict Match OR Soft Match for College Rd / Nashik Rd legacy data)
    // 5. Does the User belong to the same Center as the Data?
    // (Logic: Robust Match for varied Center ID formats)
    function canAccessCenter(resourceCenterId) {
      let uC = getUserData().centerId.upper();
      let rC = (resourceCenterId == null) ? '' : resourceCenterId.upper();
      
      return isDirector() || 
             (isSignedIn() && uC == rC) ||
             // College Road Permissive
             (isSignedIn() && (uC == 'UN_COLLEGE' || uC.matches('.*COLLEGE.*')) && (rC == '' || rC == 'UN_COLLEGE' || rC.matches('.*COLLEGE.*'))) ||
             // Nashik Road Permissive
             (isSignedIn() && (uC == 'UN_NASHIK_RD' || uC.matches('.*NASHIK.*') || uC.matches('.*JAIL.*') || uC.matches('.*ROAD.*')) && (rC == 'UN_NASHIK_RD' || rC.matches('.*NASHIK.*') || rC.matches('.*JAIL.*'))) ||
             // Prayas Permissive
             (isSignedIn() && uC.matches('.*PRAYAS.*') && rC.matches('.*PRAYAS.*'));
    }

    // --- COLLECTION RULES ---

    // A. USERS Collection
    match /users/{userId} {
      // Allow public read so Dropdowns work in Public Form
      allow read: if true; 
      // Allow Director to create anyone.
      // Allow Director/Manager to create profiles (Legacy/Admin flow)
      // Allow User to create THEMSELVES (Self-Registration Flow)
      // Security: Prevent setting 'verified' to true OR setting high-privilege ROLES on creation
      allow create: if isDirector() || isManager() || 
                    (request.auth.uid == userId && 
                     request.resource.data.verified != true &&
                     request.resource.data.role != 'DIRECTOR' && 
                     request.resource.data.role != 'MANAGER' &&
                     request.resource.data.role != 'ACCOUNTANT'
                    );
      
      // Only Director can Update or Delete
      // Exception: Manager can update (Approve) users? No, we'll keep it strict for now and give Manager a specialized function or rule later if needed.
      // Wait, Manager needs to Approve. So Manager needs update permission on 'verified' field.
      // Let's broaden update for now to allow Manager to set verified: true.
      allow update: if isDirector() || isManager();
      allow delete: if isDirector();

      // NEW: SESSIONS Sub-collection (Device Tracking)
      match /sessions/{sessionId} {
        // User can read/write their OWN sessions.
        // Director can read/write anyone's sessions (for force logout support if needed in future, currently client-side).
        allow read, write: if request.auth.uid == userId || isDirector();
      }
    }

    // B. LEADS Collection (CRM)
    // B. LEADS Collection (CRM)
    // B. LEADS Collection (CRM)
    // B. LEADS Collection (CRM)
    // B. LEADS Collection (CRM)
    match /leads/{leadId} {
      // Create: Public (Form) - WITH VALIDATION
      allow create: if true && request.resource.data.phone.matches('^\\d{10}$');
      
      // Read: RESTRICTED (Staff Only) - Fixes Data Leak
      allow read: if isSignedIn();
      
      // Update: If belongs to my center OR IS ASSIGNED TO ME
      allow update: if canAccessCenter(resource.data.centerId) || (isSignedIn() && resource.data.assignedTo == request.auth.uid);
      
      // Delete: STRICT (Director, Manager, or Accountant)
      allow delete: if isDirector() || isManager() || isAccountant();
    }

    // C. ADMISSIONS Collection (Financials - Strict)
    match /admissions/{admissionId} {
      // Read: Staff of that center + Accountants + Director + Manager (Client-side filtered)
      allow read: if canAccessCenter(resource.data.centerId) || isAccountant() || isManager();
      
      // Create: Counsellors/Accountants
      allow create: if isSignedIn();
      
      // Update: Only Director or Accountant can update payment info
      // Update: Director, Accountant, or Manager can update. Staff only if status is TOKEN_PAID.
      // FIX: Allow Staff to update REMINDER fields anytime for their own sales
      allow update: if isDirector() || isAccountant() || isManager() 
                    || (canAccessCenter(resource.data.centerId) && resource.data.status == 'TOKEN_PAID')
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextPaymentDate', 'reminderSetBy', 'lastUpdated', 'recoveryTimeline']));
      
      // Delete: STRICT (Director or Accountant)
      allow delete: if isDirector() || isAccountant(); 
    }

    // D. APPROVALS Collection
    match /approvals/{approvalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Only Director can change status to APPROVED/REJECTED
      allow update: if isDirector();
      // Delete: STRICT (Director Only)
      allow delete: if isDirector();
    }

    // E. BATCHES Collection (Added Fix)
    match /batches/{batchId} {
      // Allow Public Read for BDE Configuration specially
      allow read: if isSignedIn() || batchId == 'bde_list_configuration';
      allow create: if isDirector() || isManager(); // Director or Manager
      allow update: if isDirector() || isManager();
      allow delete: if isDirector(); // STRICT: Only Director can delete batches
    }

    // F. FEE STRUCTURES Collection (NEW)
    match /fee_structures/{feeId} {
      allow read: if isSignedIn(); // All staff/counters need to read fees
      allow write: if isDirector() || isAccountant(); // Only Accounts/Director can edit
    }
    // G. EXPLICIT SETTINGS COLLECTION (Fix for BDE List)
    match /settings/{settingId} {
      allow read: if true; // Allow public read for Front Desk password & BDE lists
      allow write: if isDirector() || isManager();
    }

    // H. AUDIT LOGS
    match /bde_audit_logs/{logId} {
      allow read: if isDirector() || isManager();
      allow create: if isSignedIn(); 
    }
    match /login_audit_logs/{logId} {
      allow create: if isSignedIn(); // Allow logging on login
      allow read: if isDirector(); // Only Director sees login history
    }
  }
}
