rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // 1. Is the user logged in?
    function isSignedIn() {
      return request.auth != null;
    }

    // 2. Fetch the User's Profile (Role & Center) from the 'users' collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 2.5 Is the user verified/approved?
    function isVerified() {
      let data = getUserData();
      return isSignedIn() && data != null && data.get('verified', true) != false;
    }

    // 3. Is the user a DIRECTOR?
    function isDirector() {
      return isVerified() && getUserData().role.upper() == 'DIRECTOR';
    }

    // 4. Is the user an ACCOUNTANT?
    function isAccountant() {
      return isVerified() && getUserData().role.upper() == 'ACCOUNTANT';
    }

    // 4.5 Is the user a MANAGER?
    function isManager() {
        return isVerified() && getUserData().role.upper() == 'MANAGER';
    }

    // 4.6 Is the user on the RECOVERY desk? They chase overdue fees of their
    // own centre: read its admissions and log calls / promised dates only.
    function isRecovery() {
        return isVerified() && getUserData().role.upper() == 'RECOVERY';
    }

    // Verified staff other than Recovery (bookings, leads, discounts).
    function isSalesStaff() {
        return isVerified() && !isRecovery();
    }

    // 5. Does the User belong to the same Center as the Data?
    // (Logic: Robust Match for varied Center ID formats)
    function getCenterId() {
      let data = getUserData();
      return (data != null && 'centerId' in data && data.centerId != null) ? data.centerId.upper() : '';
    }

    function canAccessCenter(resourceCenterId) {
      let uC = getCenterId();
      let rC = (resourceCenterId == null) ? '' : resourceCenterId.upper();
      
      return isDirector() || 
             isAccountant() ||
             (isVerified() && uC == rC) ||
             // College Road Permissive
             (isVerified() && (uC == 'UN_COLLEGE' || uC.matches('.*COLLEGE.*')) && (rC == '' || rC == 'UN_COLLEGE' || rC.matches('.*COLLEGE.*'))) ||
             // Nashik Road Permissive
             (isVerified() && (uC == 'UN_NASHIK_RD' || uC.matches('.*NASHIK.*') || uC.matches('.*JAIL.*') || uC.matches('.*ROAD.*')) && (rC == 'UN_NASHIK_RD' || rC.matches('.*NASHIK.*') || rC.matches('.*JAIL.*'))) ||
             // Prayas Permissive
             (isVerified() && uC.matches('.*PRAYAS.*') && rC.matches('.*PRAYAS.*'));
    }

    // --- COLLECTION RULES ---

    function grantsDirector() {
      return request.resource.data.get('role', '').upper() == 'DIRECTOR';
    }

    // A Manager adds and approves staff of their own centre only.
    function sameCentreAsMe(profile) {
      return getCenterId() != '' && profile.get('centerId', '') is string
          && profile.get('centerId', '').upper() == getCenterId();
    }

    function isDirectorDoc() {
      return resource.data.get('role', '').upper() == 'DIRECTOR';
    }

    // A. USERS Collection
    match /users/{userId} {
      // Staff profiles are not public. A signed-in person reads their own
      // profile (the login flow needs it before verification); verified
      // staff read everyone (dropdowns, staff lists). The one public doc is
      // the BDE name list the public form uses.
      allow read: if isVerified()
                  || (isSignedIn() && request.auth.uid == userId)
                  || userId == 'metadata_bde_list';
      // Allow Director to create anyone.
      // Allow Director/Manager to create profiles (Legacy/Admin flow)
      // Allow User to create THEMSELVES (Self-Registration Flow)
      // Security: Prevent setting 'verified' to true OR setting DIRECTOR role on creation.
      // Manager/Accountant can be requested, but they have no power until verified=true by a Director.
      // Nobody but a Director may create or hand out the DIRECTOR role.
      allow create: if isDirector()
                    || (isManager() && !grantsDirector() && sameCentreAsMe(request.resource.data))
                    || (request.auth.uid == userId &&
                        request.resource.data.verified == false &&
                        !grantsDirector()
                       );
      
      // Only Director can Update or Delete
      // Exception: Manager can update (Approve) users? No, we'll keep it strict for now and give Manager a specialized function or rule later if needed.
      // Wait, Manager needs to Approve. So Manager needs update permission on 'verified' field.
      // Let's broaden update for now to allow Manager to set verified: true.
      // A Manager can approve or deactivate staff (verified / isActive) and
      // keep the public BDE list, nothing else: no role changes, so no
      // self-promotion, and never a Director's profile.
      allow update: if isDirector()
                    || (isManager() && userId == 'metadata_bde_list')
                    || (isManager() && !isDirectorDoc() && sameCentreAsMe(resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'isActive']));
      allow delete: if isDirector();

      // NEW: SESSIONS Sub-collection (Device Tracking)
      // Personal day plan: only its owner.
      match /planner/{day} {
        allow read, write: if isSignedIn() && request.auth.uid == userId && isVerified();
      }

      match /sessions/{sessionId} {
        // User can read/write their OWN sessions.
        // Director can read/write anyone's sessions (for force logout support if needed in future, currently client-side).
        allow read, write: if request.auth.uid == userId || isDirector();
      }
    }

    // B. LEADS Collection (CRM)
    // B. LEADS Collection (CRM)
    // B. LEADS Collection (CRM)
    // B. LEADS Collection (CRM)
    // B. LEADS Collection (CRM)
    match /leads/{leadId} {
      // Create: Public (Form) - WITH VALIDATION
      // Staff create leads from several screens with many fields. The public
      // website form may only send its own fields, as a NEW lead, with sane
      // lengths, so nobody can plant an assigned/converted lead or junk data.
      allow create: if request.resource.data.phone is string
                    && request.resource.data.phone.matches('^\\d{10}$')
                    && (isSalesStaff() || (isValidPublicLead() && (!isSignedIn() || !isRecovery())));
      
      // Read: RESTRICTED (Staff Only) - Fixes Data Leak
      allow read: if isVerified();
      
      // Update: If belongs to my center OR IS ASSIGNED TO ME OR IS ACCOUNTANT
      allow update: if !isRecovery()
                    && ((isVerified() && resource.data.get('assignedTo', '') == request.auth.uid) || canAccessCenter(resource.data.get('centerId', '')) || isAccountant());
      
      // Delete: STRICT (Director, Manager, or Accountant)
      allow delete: if isDirector() || isManager() || isAccountant();
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    function isValidPublicLead() {
      let d = request.resource.data;
      return d.keys().hasOnly(['centerId', 'studentName', 'phone', 'parentPhone', 'board',
                               'currentClass', 'courseInterest', 'source', 'sourceDetails',
                               'createdAt', 'status'])
          && d.get('status', '') == 'NEW'
          && d.get('source', '') == 'Website'
          && shortString(d.get('studentName', ''), 100)
          && shortString(d.get('centerId', ''), 40)
          && shortString(d.get('parentPhone', ''), 15)
          && shortString(d.get('board', ''), 60)
          && (d.get('currentClass', null) == null || shortString(d.get('currentClass', ''), 40))
          && (d.get('courseInterest', null) == null || shortString(d.get('courseInterest', ''), 80))
          && (!('sourceDetails' in d) || (d.sourceDetails is map && d.sourceDetails.size() <= 5));
    }

    // Fields a counsellor/front-desk user may change on an admission: payment
    // reminders, recovery remarks, contact details synced from the lead, and
    // the batch. Money, status, ownership and centre are Accounts/Director only.
    function staffAdmissionFields() {
      return ['nextPaymentDate', 'reminderSetBy', 'lastUpdated', 'updatedAt', 'recoveryTimeline',
              'studentName', 'phone', 'parentPhone', 'email', 'program',
              'batchAssigned', 'batchId'];
    }

    // Fields the Recovery desk may change: its call log, promised date and
    // amount, and the next reminder. Never money, status or payments.
    function recoveryAdmissionFields() {
      return ['recoveryTimeline', 'lastContactAt', 'promisedDate', 'promisedAmount',
              'nextPaymentDate', 'reminderSetBy', 'lastUpdated', 'updatedAt'];
    }

    function ownsAdmission() {
      return resource.data.get('bookedById', '') == request.auth.uid
          || resource.data.get('counsellorId', '') == request.auth.uid;
    }

    function isAdminStaff() {
      return isDirector() || isManager() || isAccountant();
    }

    function rollChangeIsReserved(admissionId) {
      let newRoll = request.resource.data.get('rollNumber', null);
      return newRoll == resource.data.get('rollNumber', null)
          || (newRoll is string
              && getAfter(/databases/$(database)/documents/roll_numbers/$(newRoll)).data.admissionId == admissionId);
    }

    // C. ADMISSIONS Collection (Financials - Strict)
    match /admissions/{admissionId} {
      // Read: Staff of that center + Accountants + Director + Manager (Client-side filtered)
      allow read: if isDirector() || isManager() || isAccountant() || canAccessCenter(resource.data.get('centerId', ''));
      
      // Create: Director/Manager/Accountant freely. Other staff only a new
      // booking (TOKEN_PAID or PENDING_APPROVAL), booked in their own name,
      // for a centre they belong to.
      allow create: if isDirector() || isManager() || isAccountant()
                    || (isSalesStaff()
                        && request.resource.data.get('status', '') in ['TOKEN_PAID', 'PENDING_APPROVAL']
                        && request.resource.data.get('bookedById', '') == request.auth.uid
                        && canAccessCenter(request.resource.data.get('centerId', '')));

      // Update: Director, Accountant, Manager change anything. Other staff
      // only the whitelisted fields, and only on admissions of their centre
      // or ones they booked / counsel.
      // A new or changed roll number must be reserved for this admission in
      // roll_numbers in the same write (see rollNumberService.js), so no two
      // students can hold the same roll / KAP Connect enrollment number.
      allow update: if ((isDirector() || isAccountant() || isManager()) && rollChangeIsReserved(admissionId))
                    || (isRecovery()
                        && canAccessCenter(resource.data.get('centerId', ''))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(recoveryAdmissionFields()))
                    || (isSalesStaff()
                        && (canAccessCenter(resource.data.get('centerId', '')) || ownsAdmission())
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffAdmissionFields()));
      
      // Delete: STRICT (Director or Accountant)
      allow delete: if isDirector() || isAccountant(); 
    }

    // D. APPROVALS Collection
    match /approvals/{approvalId} {
      allow read: if isVerified();
      // A request always starts PENDING and in the requester's own name, so
      // nobody can file an already-approved discount.
      allow create: if isSalesStaff()
                    && request.resource.data.get('status', '') == 'PENDING'
                    && request.resource.data.get('requestedById', '') == request.auth.uid;
      // Only Director can change status to APPROVED/REJECTED
      allow update: if isDirector();
      // Delete: STRICT (Director Only)
      allow delete: if isDirector();
    }

    // E. BATCHES Collection (Added Fix)
    match /batches/{batchId} {
      // Public read for BDE Configuration, and for UPCOMING/ACTIVE batches,
      // which the public home page lists (UpcomingBatchesPublic). Without the
      // second clause that section failed for every visitor who was not
      // signed in.
      allow read: if isVerified()
                  || batchId == 'bde_list_configuration'
                  || resource.data.get('status', '') in ['UPCOMING', 'ACTIVE'];
      allow create: if isDirector() || isManager(); // Director or Manager
      allow update: if isDirector() || isManager();
      allow delete: if isDirector() || isManager(); // FIX: Manager can now delete batches
    }

    // F. FEE STRUCTURES Collection (NEW)
    match /fee_structures/{feeId} {
      allow read: if isVerified(); // All staff/counters need to read fees
      allow write: if isDirector() || isAccountant(); // Only Accounts/Director can edit
    }
    // G. EXPLICIT SETTINGS COLLECTION (Fix for BDE List)
    match /settings/{settingId} {
      // Staff only. This collection holds the Front Desk password, which
      // anyone on the internet could read while this was `if true`.
      allow read: if isVerified();
      // The academic-year start date is the Director's alone.
      allow write: if isDirector() || (isManager() && settingId != 'academic_year');
    }

    // I. ROLL NUMBERS: per centre-year counters and one reservation per roll.
    match /counters/{counterId} {
      allow read, write: if isAdminStaff() && counterId.matches('^roll_(110|111|112)[0-9]{2}$');
    }
    match /roll_numbers/{roll} {
      allow read: if isVerified();
      // A reservation is only created together with the admission that
      // takes the roll, and can't be moved to another admission.
      allow create: if isAdminStaff()
                    && roll.matches('^(110|111|112)[0-9]{6}$')
                    && request.resource.data.admissionId is string
                    && getAfter(/databases/$(database)/documents/admissions/$(request.resource.data.admissionId)).data.rollNumber == roll;
      allow update: if isAdminStaff()
                    && request.resource.data.admissionId == resource.data.admissionId;
      allow delete: if isAdminStaff()
                    && getAfter(/databases/$(database)/documents/admissions/$(resource.data.admissionId)).data.get('rollNumber', null) != roll;
    }

    // H. AUDIT LOGS
    match /bde_audit_logs/{logId} {
      allow read: if isDirector() || isManager();
      allow create: if isVerified(); 
    }
    match /login_audit_logs/{logId} {
      allow create: if isSignedIn(); // Allow logging on login
      allow read: if isDirector(); // Only Director sees login history
    }
  }
}
