rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Staff only. Images already shared by download URL keep working,
      // because those URLs carry their own access token.
      allow read: if request.auth != null;

      // The app no longer uploads to Storage (proof images are stored inline
      // on the admission). Uploads used to be open to any signed-in account,
      // including unapproved self-registrations, which could also overwrite
      // or delete any existing file.
      allow write: if false;
    }
  }
}
